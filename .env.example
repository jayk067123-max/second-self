# ============================================================
# 环境变量模板 —— 复制为 .env 后填写真实值
#   PowerShell: Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密钥
# ============================================================

# ---- 应用基础 ----
# 应用监听端口
PORT=3000
# 公开访问地址（本地开发用 localhost）
APP_URL=http://localhost:3000

# ---- 大模型 API（按实际使用的服务商填写，不要填其他家的）----
# 服务商接口地址（需兼容 OpenAI 协议，如 https://api.deepseek.com/v1）
LLM_BASE_URL=
# 密钥：留空则自动进入 demo 模式（返回结构合法的固定响应，全链路可演示）
LLM_API_KEY=
# 模型名
LLM_MODEL=

# ---- AI 调用的工程约束（骨架第 5 步启用）----
# 单次调用超时（毫秒）
AI_REQUEST_TIMEOUT_MS=30000
# 结构化输出校验失败后的最大重试次数（1 次原始 + N 次修复）
AI_MAX_RETRIES=3
# 同一会话连续失败多少次后熔断，转为提示用户手工修正
AI_CIRCUIT_BREAKER_THRESHOLD=5

# ---- 持久化（无需配置）----
# 本项目不使用服务端数据库，任务数据保存在浏览器 localStorage。
# 因此这里没有任何 DATABASE_URL 之类的配置项，装完即可用。
# 如需备份或迁移数据，使用界面上的「导出 JSON / 导入 JSON」功能。
