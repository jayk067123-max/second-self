# ============================================================
# 环境变量模板 —— 复制为 .env 后填写真实值
#   PowerShell: Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密钥
# ============================================================

# ---- 应用基础 ----
# 应用监听端口
PORT=3000
# 公开访问地址（本地开发用 localhost）
APP_URL=http://localhost:3000

# ---- 大模型 API（按实际使用的服务商填写，不要填其他家的）----
# 服务商接口地址
LLM_BASE_URL=
# 密钥
LLM_API_KEY=
# 模型名
LLM_MODEL=

# ---- 数据库 ----
# 本地默认使用 SQLite 文件，无需额外服务
DATABASE_URL=file:./data/app.db
